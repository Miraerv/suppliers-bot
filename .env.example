BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
COMPANY_NAME=Boontar
# ID закрытого чата/группы закупок (бот должен быть админом или участником)
# Узнать: переслать сообщение из чата боту @userinfobot / @getidsbot
ADMIN_CHAT_ID=-1001234567890
MANAGER_CONTACTS=свяжитесь с вашим менеджером: @buyer_manager
# В Docker volume ./data → /app/data; локально — папка data/ в корне проекта
DATA_DIR=data
# Часы напоминаний о прайсе (якутское время), через запятую
REMINDER_HOURS=10,15

# Telegram API via reverse proxy (when api.telegram.org is blocked)
USE_TPROXY=false
TPROXY_BASE=https://tg.michaelmironov122.online
